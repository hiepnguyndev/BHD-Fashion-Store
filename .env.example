# Sao chép thành .env rồi sửa, hoặc chạy ./generate_env.sh để tự sinh mật khẩu ngẫu nhiên.
# Giá trị __MAT_KHAU__, __KHOA__, __APP_KEY__ sẽ được generate_env.sh thay bằng chuỗi ngẫu nhiên.

# ===== Chung =====
TEN_CUA_HANG="BHD Fashion Store"
WEB_URL=http://localhost:8080
# Đặt true khi chạy sau HTTPS (cookie đăng nhập chỉ gửi qua kết nối an toàn)
COOKIE_SECURE=false

# ===== SQL Server =====
# 2022-latest chắc chắn có sẵn; có thể thử 2025-latest (Express giới hạn 50 GB mỗi CSDL)
MSSQL_PHIEN_BAN=2022-latest
# Mật khẩu SQL Server cần đủ phức tạp (chữ hoa, chữ thường, số, ký hiệu)
MSSQL_SA_PASSWORD=__MAT_KHAU__
MK_NGUOIDUNG=__MAT_KHAU__
MK_SANPHAM=__MAT_KHAU__
MK_GIOHANG=__MAT_KHAU__
MK_DONHANG=__MAT_KHAU__
MK_THANHTOAN=__MAT_KHAU__
MK_THONGBAO=__MAT_KHAU__

# ===== Bảo mật giữa các dịch vụ =====
KHOA_NOI_BO=__KHOA__
APP_KEY_THONG_BAO=__APP_KEY__

# ===== Vận chuyển / giữ hàng (VND, phút) =====
PHI_VAN_CHUYEN=30000
MIEN_PHI_VAN_CHUYEN_TU=500000
HAN_THANH_TOAN_PHUT=15

# ===== Thanh toán: tài khoản ngân hàng nhận tiền (VietQR) =====
NGAN_HANG_TEN=Vietcombank
# Mã BIN của ngân hàng theo chuẩn VietQR (Vietcombank = 970436)
NGAN_HANG_BIN=970436
NGAN_HANG_SO_TAI_KHOAN=0123456789
NGAN_HANG_TEN_CHU_TK=NGUYEN VAN A
# Tiền tố mã thanh toán: phải trùng cấu trúc mã thanh toán đã cấu hình trong SePay
MA_THANH_TOAN_TIEN_TO=TT

# ===== SePay =====
# Webhook giao dịch ngân hàng: dán cùng chuỗi này vào mục xác thực API Key khi tạo webhook trên my.sepay.vn
SEPAY_WEBHOOK_API_KEY=__KHOA__
# Khóa HMAC-SHA256 (whsec_...) từ SePay; nếu điền thì webhook xác thực bằng HMAC thay vì API Key
SEPAY_WEBHOOK_SECRET=
# Cổng thanh toán SePay (để trống nếu chưa dùng): sandbox hoặc production
SEPAY_PG_MERCHANT_ID=
SEPAY_PG_SECRET_KEY=
SEPAY_PG_MOI_TRUONG=sandbox

# ===== Email =====
# Mặc định gửi vào hộp thư thử nghiệm Mailpit (http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Để trống khi dùng Mailpit; đặt smtps nếu SMTP thật dùng cổng 465
MAIL_SCHEME=
MAIL_FROM_ADDRESS=no-reply@localhost

# Thông tin hiển thị ở trang Liên hệ (để trống = hiện "Đang cập nhật")
LIEN_HE_DIA_CHI=
LIEN_HE_DIEN_THOAI=
LIEN_HE_EMAIL=
LIEN_HE_GIO_LAM_VIEC=
